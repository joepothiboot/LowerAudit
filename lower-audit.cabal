cabal-version: 3.14
name:          lower-audit
version:       0.1.0.0
build-type:    Simple
tested-with:   GHC ==9.10.3

common shared
  default-language: GHC2021
  ghc-options:      -Wall
  build-depends:    base ^>=4.20

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    LowerAudit
    LowerAudit.Classify
    LowerAudit.Concretize
    LowerAudit.Domain
    LowerAudit.Enumerate
    LowerAudit.Manifest
    LowerAudit.Oracle
    LowerAudit.Render
    LowerAudit.Report
    LowerAudit.Run
    LowerAudit.Slice
  build-depends:
    , aeson
    , bytestring
    , directory
    , filepath
    , process
    , SHA
    , text
    , time

executable lower-audit
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:  lower-audit

test-suite lower-audit-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-tool-depends: lower-audit:lower-audit
  other-modules:
    ClassifySpec
    ConcretizeSpec
    DomainSpec
    EnumerateSpec
    ExecutableOracleSpec
    Generators
    ManifestSpec
    OracleSpec
    ProbeSpec
    RenderSpec
    ReportSpec
    RunSpec
    SliceSpec
  build-depends:
    , aeson
    , bytestring
    , directory
    , filepath
    , lower-audit
    , process
    , tasty
    , tasty-golden
    , tasty-hunit
    , tasty-quickcheck
    , temporary
    , text
    , time
